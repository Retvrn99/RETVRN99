# SeaBIOS rel-1.16.3 profile for the RETVRN99 virtual machine.

CONFIG_QEMU=y
CONFIG_ROM_SIZE=128
CONFIG_ATA_DMA=n
CONFIG_XEN=n
CONFIG_ATA_PIO32=n
CONFIG_FLASH_FLOPPY=n
CONFIG_AHCI=n
CONFIG_SDCARD=n
CONFIG_VIRTIO_BLK=n
CONFIG_VIRTIO_SCSI=n
CONFIG_PVSCSI=n
CONFIG_ESP_SCSI=n
CONFIG_LSI_SCSI=n
CONFIG_MEGASAS=n
CONFIG_MPT_SCSI=n
CONFIG_NVME=n
CONFIG_USE_SMM=n
CONFIG_VGAHOOKS=n
CONFIG_HOST_BIOS_GEOMETRY=n
CONFIG_USB=n
CONFIG_SERIAL=n
CONFIG_SERCON=n
CONFIG_LPT=n
CONFIG_PMTIMER=n
CONFIG_PCIBIOS=y
CONFIG_DISABLE_A20=n
CONFIG_WRITABLE_UPPERMEMORY=n
CONFIG_TCGBIOS=n
CONFIG_S3_RESUME=n
CONFIG_MPTABLE=n
CONFIG_ACPI=n
CONFIG_ACPI_PARSE=n
CONFIG_FW_ROMFILE_LOAD=n
CONFIG_DEBUG_SERIAL=n
CONFIG_DEBUG_SERIAL_MMIO=n
