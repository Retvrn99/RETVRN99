{
  "_spdx": "GPL-3.0-only",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mesa-compiler-closure.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_spdx", "schema", "schema_definition", "status", "reason", "source",
    "inputs", "direct_recipe", "depfile_contract", "object_contract",
    "exclusions", "evidence", "scope"
  ],
  "properties": {
    "_spdx": {"const": "GPL-3.0-only"},
    "schema": {"const": 3},
    "schema_definition": {"$ref": "#/$defs/binding"},
    "status": {"const": "compile-proven"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 2048},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "owning_commit", "mesa_version", "mesa_subtree"],
      "properties": {
        "repository": {"const": "https://github.com/JHRobotics/mesa9x.git"},
        "owning_commit": {"const": "29b9adb44bc5ea54dc53c02b5e4b49292c6cc04f"},
        "mesa_version": {"const": "23.1.9"},
        "mesa_subtree": {"const": "mesa-23.1.x"}
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/named_binding"}
    },
    "direct_recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "inventory_units", "compile_units", "support_only_units", "compiler_command_count", "upstream_makefile_command_consumption"],
      "properties": {
        "status": {"const": "exact-metadata-with-compiler-object-evidence"},
        "inventory_units": {"const": 874},
        "compile_units": {"const": 869},
        "support_only_units": {"const": 5},
        "compiler_command_count": {"const": 869},
        "upstream_makefile_command_consumption": {"const": false}
      }
    },
    "depfile_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "missing_header_mode", "include_system_headers", "one_depfile_per_command", "twin_run_required", "path_identity", "proof_source_root", "include_precedence", "logical_roots"],
      "properties": {
        "mode": {"const": "gcc-M-MF-MT"},
        "missing_header_mode": {"const": "reject-no-MG"},
        "include_system_headers": {"const": true},
        "one_depfile_per_command": {"const": true},
        "twin_run_required": {"const": true},
        "path_identity": {"const": "logical-root-forward-slash-ordinal-case-sensitive"},
        "proof_source_root": {"const": "exact-materialized-1489-file-canonical-lf-root"},
        "include_precedence": {"const": "reviewed-generated-before-canonical-source"},
        "logical_roots": {"const": ["source", "generated", "original", "toolchain"]}
      }
    },
    "object_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format", "machine", "optional_header_bytes", "timestamp_offset",
        "timestamp_bytes", "normalized_byte_offsets", "maximum_object_bytes",
        "twin_run_required", "object_identity_collision_free",
        "private_path_policy", "aggregate_algorithm",
        "temporary_outputs_retained", "linker_invocations",
        "include_precedence"
      ],
      "properties": {
        "format": {"const": "coff-i386"},
        "machine": {"const": 332},
        "optional_header_bytes": {"const": 0},
        "timestamp_offset": {"const": 4},
        "timestamp_bytes": {"const": 4},
        "normalized_byte_offsets": {"const": [4, 5, 6, 7]},
        "maximum_object_bytes": {"const": 67108864},
        "twin_run_required": {"const": true},
        "object_identity_collision_free": {"const": true},
        "private_path_policy": {"const": "reject-bound-roots-ascii-utf8-utf16le-before-hash"},
        "aggregate_algorithm": {"const": "sha256-utf8-tab-records-v1"},
        "temporary_outputs_retained": {"const": false},
        "linker_invocations": {"const": 0},
        "include_precedence": {"const": "reviewed-generated-before-canonical-source"}
      }
    },
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path_fragments", "include_path_fragments", "common_define_names", "define_prefixes", "support_only_generated_sources"],
      "properties": {
        "source_path_fragments": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}},
        "include_path_fragments": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string"}},
        "common_define_names": {"const": ["GALLIUM_SOFTPIPE", "HAVE_PTHREAD", "USE_X86_ASM", "GLX_X86_READONLY_TEXT", "HAVE_LLVM", "HAVE_GALLIUM_LLVMPIPE", "GALLIUM_LLVMPIPE", "HAVE_LLVMPIPE", "DRAW_LLVM_AVAILABLE"]},
        "define_prefixes": {"const": ["VBOX_"]},
        "support_only_generated_sources": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "object_profile", "unit_argument_overrides", "commands", "headers", "objects", "summary"],
      "properties": {
        "profile": {"$ref": "#/$defs/dependency_profile"},
        "object_profile": {"$ref": "#/$defs/object_profile"},
        "unit_argument_overrides": {"$ref": "#/$defs/unit_argument_overrides"},
        "commands": {"type": "array", "minItems": 869, "maxItems": 869, "items": {"$ref": "#/$defs/command"}},
        "headers": {"type": "array", "minItems": 1070, "maxItems": 1070, "items": {"$ref": "#/$defs/header"}},
        "objects": {"type": "array", "minItems": 869, "maxItems": 869, "items": {"$ref": "#/$defs/object"}},
        "summary": {"$ref": "#/$defs/summary"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "claims", "authorizations"],
      "properties": {
        "classification": {"const": "compiler-dependency-and-twin-object-proof"},
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "direct_recipe_reviewed", "compiler_commands_complete",
            "depfiles_reproducible", "header_dependency_set_complete",
            "exact_materialized_source_root",
            "backend_source_include_exclusions_proven",
            "common_define_exclusions_proven",
            "unit_compile_context_exception_bound",
            "project_header_license_closure", "object_compilation_complete",
            "object_compilation_reproducible", "object_identity_collision_free",
            "upstream_recipe_reproduced", "pthread_link_abi_proven",
            "build_closure", "graphics_stack_integrated"
          ],
          "properties": {
            "direct_recipe_reviewed": {"const": true},
            "compiler_commands_complete": {"const": true},
            "depfiles_reproducible": {"const": true},
            "header_dependency_set_complete": {"const": true},
            "exact_materialized_source_root": {"const": true},
            "backend_source_include_exclusions_proven": {"const": true},
            "common_define_exclusions_proven": {"const": true},
            "unit_compile_context_exception_bound": {"const": true},
            "project_header_license_closure": {"const": true},
            "object_compilation_complete": {"const": true},
            "object_compilation_reproducible": {"const": true},
            "object_identity_collision_free": {"const": true},
            "upstream_recipe_reproduced": {"const": false},
            "pthread_link_abi_proven": {"const": false},
            "build_closure": {"const": false},
            "graphics_stack_integrated": {"const": false}
          }
        },
        "authorizations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["production_build", "link", "stage", "guest_install", "dll_activation", "renderer_selection", "capability_advertisement"],
          "properties": {
            "production_build": {"const": false},
            "link": {"const": false},
            "stage": {"const": false},
            "guest_install": {"const": false},
            "dll_activation": {"const": false},
            "renderer_selection": {"const": false},
            "capability_advertisement": {"const": false}
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "bytes", "sha256"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1, "maxLength": 256},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "named_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relative_path", "bytes", "sha256", "required_state"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "relative_path": {"type": "string", "minLength": 1, "maxLength": 256},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "required_state": {"type": "string", "minLength": 1, "maxLength": 96}
      }
    },
    "language_arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["c-gnu99", "cxx-gnu++14", "assembler-with-cpp"],
      "properties": {
        "c-gnu99": {"const": ["-std=gnu99"]},
        "cxx-gnu++14": {"const": ["-std=gnu++14"]},
        "assembler-with-cpp": {"const": ["-x", "assembler-with-cpp", "-DGNU_ASSEMBLER", "-DSTDCALL_API", "-D__MINGW32__"]}
      }
    },
    "unit_argument_overrides": {
      "const": [
        {
          "command_id": "cmd-0002",
          "source": "{source}/mesa-23.1.x/src/c11/impl/threads_posix.c",
          "profiles": ["mesa-dependency-v1", "mesa-object-v1"],
          "insertion": "after-common-before-language",
          "arguments": ["-DHAVE_PTHREAD"],
          "mode": "compile-context-only-no-link"
        },
        {
          "command_id": "cmd-0792",
          "source": "{source}/mesa-23.1.x/src/util/rwlock.c",
          "profiles": ["mesa-dependency-v1", "mesa-object-v1"],
          "insertion": "after-common-before-language",
          "arguments": ["-DHAVE_PTHREAD"],
          "mode": "compile-context-only-no-link"
        },
        {
          "command_id": "cmd-0852",
          "source": "{generated}/mesa-23.1.x/src/mapi/glapi/gen/glapi_x86.S",
          "profiles": ["mesa-dependency-v1", "mesa-object-v1"],
          "insertion": "after-common-before-language",
          "arguments": ["-DUSE_X86_ASM", "-DGLX_X86_READONLY_TEXT"],
          "mode": "compile-context-only-no-link"
        }
      ]
    },
    "dependency_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "missing_header_mode", "include_system_headers", "timeout_seconds", "maximum_concurrent_children", "batch_size", "batch_quiescence_milliseconds", "common_arguments", "language_arguments"],
      "properties": {
        "id": {"const": "mesa-dependency-v1"},
        "mode": {"const": "gcc-M-MF-MT"},
        "missing_header_mode": {"const": "reject-no-MG"},
        "include_system_headers": {"const": true},
        "timeout_seconds": {"const": 30},
        "maximum_concurrent_children": {"const": 1},
        "batch_size": {"const": 25},
        "batch_quiescence_milliseconds": {"const": 1000},
        "common_arguments": {"type": "array", "minItems": 100, "maxItems": 256, "items": {"type": "string"}},
        "language_arguments": {"$ref": "#/$defs/language_arguments"}
      }
    },
    "object_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "timeout_seconds", "maximum_concurrent_children", "batch_size", "batch_quiescence_milliseconds", "common_arguments", "language_arguments", "per_unit_arguments", "working_directory", "linker_invocations"],
      "properties": {
        "id": {"const": "mesa-object-v1"},
        "mode": {"const": "compile-only-no-link"},
        "timeout_seconds": {"const": 30},
        "maximum_concurrent_children": {"const": 1},
        "batch_size": {"const": 25},
        "batch_quiescence_milliseconds": {"const": 1000},
        "common_arguments": {"type": "array", "minItems": 100, "maxItems": 256, "items": {"type": "string"}},
        "language_arguments": {"$ref": "#/$defs/language_arguments"},
        "per_unit_arguments": {"const": [
          "-frandom-seed=retvrn99-mesa-{command-id}-v1",
          "-ffile-prefix-map={source}=retvrn99/source",
          "-fmacro-prefix-map={source}=retvrn99/source",
          "-ffile-prefix-map={generated}=retvrn99/generated",
          "-fmacro-prefix-map={generated}=retvrn99/generated",
          "-ffile-prefix-map={original}=retvrn99/original",
          "-fmacro-prefix-map={original}=retvrn99/original",
          "-ffile-prefix-map={toolchain}=retvrn99/toolchain",
          "-fmacro-prefix-map={toolchain}=retvrn99/toolchain",
          "-ffile-prefix-map={proof}=retvrn99/proof",
          "-fmacro-prefix-map={proof}=retvrn99/proof",
          "-c", "{source-file}", "-o", "{object-file}"
        ]},
        "working_directory": {"const": "{proof}"},
        "linker_invocations": {"const": 0}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "unit_ordinal", "language", "compiler", "source", "object", "depfile", "profile", "dependency_count", "twin_sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^cmd-[0-9]{4}$"},
        "unit_ordinal": {"type": "integer", "minimum": 1, "maximum": 869},
        "language": {"enum": ["c-gnu99", "cxx-gnu++14", "assembler-with-cpp"]},
        "compiler": {"type": "string", "pattern": "^\\{toolchain\\}/bin/.+\\.exe$"},
        "source": {"type": "string", "pattern": "^\\{(source|generated|original)\\}/"},
        "object": {"type": "string", "pattern": "^obj/.+\\.o$"},
        "depfile": {"type": "string", "pattern": "^dep/cmd-[0-9]{4}\\.d$"},
        "profile": {"const": "mesa-dependency-v1"},
        "dependency_count": {"type": "integer", "minimum": 1, "maximum": 4096},
        "twin_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "relative_path", "bytes", "sha256", "license_scope"],
      "properties": {
        "root": {"enum": ["source", "generated", "original", "toolchain"]},
        "relative_path": {"type": "string", "minLength": 1, "maxLength": 768},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "sha256": {"$ref": "#/$defs/sha256"},
        "license_scope": {"enum": ["reviewed-component-closure", "reviewed-generated-output-lock", "GPL-3.0-only", "locked-toolchain-distribution"]}
      }
    },
    "object_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_sha256", "timestamp", "normalized_sha256"],
      "properties": {
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "timestamp": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "normalized_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command_id", "unit_ordinal", "object", "random_seed", "bytes", "run_a", "run_b", "normalized_sha256", "twin_byte_identical"],
      "properties": {
        "id": {"type": "string", "pattern": "^object-[0-9]{4}$"},
        "command_id": {"type": "string", "pattern": "^cmd-[0-9]{4}$"},
        "unit_ordinal": {"type": "integer", "minimum": 1, "maximum": 869},
        "object": {"type": "string", "pattern": "^obj/.+\\.o$", "maxLength": 768},
        "random_seed": {"type": "string", "pattern": "^retvrn99-mesa-cmd-[0-9]{4}-v1$"},
        "bytes": {"type": "integer", "minimum": 20, "maximum": 67108864},
        "run_a": {"$ref": "#/$defs/object_run"},
        "run_b": {"$ref": "#/$defs/object_run"},
        "normalized_sha256": {"$ref": "#/$defs/sha256"},
        "twin_byte_identical": {"const": true}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_count", "twin_depfile_count", "unique_dependency_count",
        "dependency_root_counts", "twin_byte_identical", "failed_command_count",
        "exact_source_root", "exact_source_root_file_count",
        "object_compile_count", "unique_object_count",
        "twin_objects_byte_identical", "object_identity_collision_count",
        "failed_object_compile_count", "temporary_object_count",
        "aggregate_object_sha256"
      ],
      "properties": {
        "command_count": {"const": 869},
        "twin_depfile_count": {"const": 1738},
        "unique_dependency_count": {"const": 1070},
        "dependency_root_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "generated", "original", "toolchain"],
          "properties": {
            "source": {"const": 651},
            "generated": {"const": 29},
            "original": {"const": 4},
            "toolchain": {"const": 386}
          }
        },
        "twin_byte_identical": {"const": true},
        "failed_command_count": {"const": 0},
        "exact_source_root": {"const": true},
        "exact_source_root_file_count": {"const": 1489},
        "object_compile_count": {"const": 1738},
        "unique_object_count": {"const": 869},
        "twin_objects_byte_identical": {"const": true},
        "object_identity_collision_count": {"const": 0},
        "failed_object_compile_count": {"const": 0},
        "temporary_object_count": {"const": 0},
        "aggregate_object_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
