diff --git a/vxd_main.c b/vxd_main.c
--- a/vxd_main.c
+++ b/vxd_main.c
@@ -417,6 +417,30 @@ WORD __stdcall VXD_API_Proc(PCRS_32 state)
 			state->Client_ECX = FBHDA_gamma_set((void *)state->Client_ESI, state->Client_ECX);
 			rc = 1;
 			break;
+#ifdef GSW
+		case GSW_GDI_PM16_QUERY:
+			state->Client_ECX = GSW_transport_capabilities() &
+				(GSW_VGA_CAP_GDI_ROP3 | GSW_VGA_CAP_GDI_FAST_DOORBELL |
+				 GSW_VGA_CAP_GDI_SYNC_COOKIE);
+			rc = 1;
+			break;
+		case GSW_GDI_PM16_SUBMIT:
+			{
+				GSWGdiBltCommand request;
+				DWORD byte_count = state->Client_ECX;
+				DWORD request_linear = state->Client_ESI;
+				state->Client_ECX = 0;
+				if(byte_count == sizeof(request) && request_linear != 0)
+				{
+					memcpy(&request, (const void *)request_linear, sizeof(request));
+					state->Client_ECX = GSW_transport_gdi_blt(
+						&request, sizeof(request)
+					);
+				}
+				rc = 1;
+				break;
+			}
