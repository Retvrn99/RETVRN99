{
  "_spdx": "GPL-3.0-only",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component-closure-v2.schema.json",
  "title": "RETVRN99 Windows 98 reviewed component closure v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_spdx",
    "schema",
    "status",
    "reason",
    "upstream_name",
    "owning_commit",
    "source_prefixes",
    "license_evidence",
    "files"
  ],
  "properties": {
    "_spdx": {"const": "GPL-3.0-only"},
    "schema": {"const": 2},
    "status": {"enum": ["blocked", "ready"]},
    "reason": {"type": "string", "maxLength": 512},
    "upstream_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "owning_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_prefixes": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/sourcePrefix"}
    },
    "license_evidence": {
      "type": "array",
      "maxItems": 40000,
      "items": {"$ref": "#/$defs/licenseEvidence"}
    },
    "files": {
      "type": "array",
      "maxItems": 20000,
      "items": {"$ref": "#/$defs/file"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "blocked"}}},
      "then": {"properties": {"reason": {"minLength": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "ready"}}},
      "then": {
        "properties": {
          "reason": {"const": ""},
          "source_prefixes": {"minItems": 1},
          "license_evidence": {"minItems": 1},
          "files": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "gitBlob": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "blobBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 536870912
    },
    "licenseEvidenceBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 536870912
    },
    "declaredLicenseExpression": {
      "enum": [
        "MIT",
        "LGPL-2.1-or-later",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "BSL-1.0",
        "Apache-2.0",
        "LicenseRef-Mesa-SHA1-Public-Domain",
        "LicenseRef-Mesa-DbgHelp-Public-Domain",
        "LicenseRef-Mesa-Jimenez-MLAA",
        "MIT AND BSD-3-Clause",
        "MIT AND Apache-2.0",
        "GPL-2.0-only OR MIT",
        "GPL-3.0-only OR MIT",
        "GPL-2.0-only AND MIT",
        "GPL-3.0-or-later WITH Bison-exception-2.2",
        "MIT AND (GPL-3.0-or-later WITH Bison-exception-2.2)"
      ]
    },
    "observedLicenseExpression": {
      "enum": [
        "MIT",
        "LGPL-2.1-or-later",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "BSL-1.0",
        "Apache-2.0",
        "GPL-2.0-only",
        "GPL-3.0-only",
        "GPL-3.0-or-later",
        "LicenseRef-Mesa-SHA1-Public-Domain",
        "LicenseRef-Mesa-DbgHelp-Public-Domain",
        "LicenseRef-Mesa-Jimenez-MLAA",
        "MIT AND BSD-3-Clause",
        "MIT AND Apache-2.0",
        "GPL-2.0-only OR MIT",
        "GPL-3.0-only OR MIT",
        "GPL-2.0-only AND MIT",
        "GPL-3.0-or-later WITH Bison-exception-2.2",
        "MIT AND (GPL-3.0-or-later WITH Bison-exception-2.2)"
      ]
    },
    "selectedLicenseExpression": {
      "enum": [
        "MIT",
        "LGPL-2.1-or-later",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "BSL-1.0",
        "Apache-2.0",
        "LicenseRef-Mesa-SHA1-Public-Domain",
        "LicenseRef-Mesa-DbgHelp-Public-Domain",
        "LicenseRef-Mesa-Jimenez-MLAA",
        "MIT AND BSD-3-Clause",
        "MIT AND Apache-2.0",
        "GPL-2.0-only",
        "GPL-3.0-only",
        "GPL-2.0-only AND MIT",
        "GPL-3.0-or-later",
        "GPL-3.0-or-later WITH Bison-exception-2.2",
        "MIT AND (GPL-3.0-or-later WITH Bison-exception-2.2)"
      ]
    },
    "sourcePrefix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relative_path", "mode"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "relative_path": {"$ref": "#/$defs/relativePath"},
        "mode": {"enum": ["subtree", "exact-root-files"]}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "subtree"}}},
          "then": {"properties": {"relative_path": {"not": {"const": "."}}}}
        },
        {
          "if": {"properties": {"mode": {"const": "exact-root-files"}}},
          "then": {"properties": {"relative_path": {"const": "."}}}
        }
      ]
    },
    "wholeFileLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {"kind": {"const": "whole-file"}}
    },
    "byteRangeLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "byte_offset", "byte_count", "sha256"],
      "properties": {
        "kind": {"const": "byte-range"},
        "byte_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 536870912
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "licenseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "relative_path",
        "git_blob",
        "bytes",
        "sha256",
        "source_prefix_id",
        "locator",
        "observed_license_expression"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["license-document", "inline"]},
        "relative_path": {"$ref": "#/$defs/relativePath"},
        "git_blob": {"$ref": "#/$defs/gitBlob"},
        "bytes": {"$ref": "#/$defs/licenseEvidenceBytes"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_prefix_id": {"$ref": "#/$defs/identifier"},
        "locator": {
          "oneOf": [
            {"$ref": "#/$defs/wholeFileLocator"},
            {"$ref": "#/$defs/byteRangeLocator"}
          ]
        },
        "observed_license_expression": {
          "$ref": "#/$defs/observedLicenseExpression"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "git_blob",
        "bytes",
        "sha256",
        "declared_license_expression",
        "selected_license_expression",
        "license_evidence_ids",
        "source_prefix_id",
        "roles"
      ],
      "properties": {
        "relative_path": {"$ref": "#/$defs/relativePath"},
        "git_blob": {"$ref": "#/$defs/gitBlob"},
        "bytes": {"$ref": "#/$defs/blobBytes"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "declared_license_expression": {
          "$ref": "#/$defs/declaredLicenseExpression"
        },
        "selected_license_expression": {
          "$ref": "#/$defs/selectedLicenseExpression"
        },
        "license_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "source_prefix_id": {"$ref": "#/$defs/identifier"},
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "source-unit",
              "compiler-dependency",
              "generator-input",
              "build-description",
              "resource"
            ]
          }
        }
      }
    }
  }
}
