{
  "_spdx": "GPL-3.0-only",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mesa-gsw-build-profile.schema.json",
  "title": "RETVRN99 Mesa GSW compile profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_spdx",
    "schema",
    "schema_definition",
    "status",
    "reason",
    "source",
    "generation_strategy",
    "target",
    "allowed_families",
    "required_support_families",
    "forbidden_features",
    "dependencies"
  ],
  "properties": {
    "_spdx": {"const": "GPL-3.0-only"},
    "schema": {"const": 1},
    "schema_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": {"const": "mesa-gsw-build-profile.schema.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "status": {"const": "blocked"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 1024},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_name",
        "repository",
        "owning_commit",
        "mesa_version",
        "mesa_subtree"
      ],
      "properties": {
        "upstream_name": {"const": "mesa9x"},
        "repository": {"const": "https://github.com/JHRobotics/mesa9x.git"},
        "owning_commit": {"const": "29b9adb44bc5ea54dc53c02b5e4b49292c6cc04f"},
        "mesa_version": {"const": "23.1.9"},
        "mesa_subtree": {"const": "mesa-23.1.x"}
      }
    },
    "generation_strategy": {"const": "hash-locked-generated-outputs"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "guest_os",
        "architecture",
        "command_ir",
        "host_renderer",
        "winsys_implementation",
        "memory_helper_implementation",
        "artifact_class",
        "compile_only",
        "build_authorized",
        "staging_authorized",
        "guest_install_authorized",
        "dll_activation_authorized",
        "renderer_selection"
      ],
      "properties": {
        "id": {"const": "mesa-23-1-9-gsw-i686-win98se"},
        "kind": {"const": "direct-pruned-compile-only"},
        "guest_os": {"const": "windows-98-se"},
        "architecture": {"const": "i686"},
        "command_ir": {"const": "svga10-internal-only"},
        "host_renderer": {"const": "sdl-gpu-vulkan-only"},
        "winsys_implementation": {"const": "retvrn99-original-gsw"},
        "memory_helper_implementation": {"const": "retvrn99-original-gsw"},
        "artifact_class": {"const": "non-package-compile-evidence"},
        "compile_only": {"const": true},
        "build_authorized": {"const": false},
        "staging_authorized": {"const": false},
        "guest_install_authorized": {"const": false},
        "dll_activation_authorized": {"const": false},
        "renderer_selection": {"const": false}
      }
    },
    "allowed_families": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"const": "mesa-core"},
        {"const": "wgl"},
        {"const": "svga-gallium"},
        {"const": "nine"},
        {"const": "d3d8to9"}
      ],
      "items": false
    },
    "required_support_families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {"const": "gallium-auxiliary"}
      ],
      "items": false
    },
    "forbidden_features": {
      "type": "array",
      "minItems": 29,
      "maxItems": 29,
      "prefixItems": [
        {"const": "alternate-mesa-generations"},
        {"const": "bochs-3d"},
        {"const": "d3d10"},
        {"const": "final-dll-activation"},
        {"const": "llvm"},
        {"const": "llvmpipe"},
        {"const": "osmesa"},
        {"const": "qemu-3dfx"},
        {"const": "renderer-selection"},
        {"const": "softgpu-dependency"},
        {"const": "softgpu-device-identity"},
        {"const": "softgpu-installer"},
        {"const": "softgpu-runtime"},
        {"const": "softpipe"},
        {"const": "svga9-production"},
        {"const": "user-selectable-renderer"},
        {"const": "vesa-3d"},
        {"const": "virgl"},
        {"const": "virtualbox-memory-helpers"},
        {"const": "virtualbox-winsys"},
        {"const": "vmware-branding"},
        {"const": "vmware-device-emulation"},
        {"const": "vmware-memory-helpers"},
        {"const": "vmware-winsys"},
        {"const": "windows-95-payloads"},
        {"const": "windows-me-payloads"},
        {"const": "wine9x-runtime"},
        {"const": "wined3d"},
        {"const": "zink"}
      ],
      "items": false
    },
    "dependencies": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/dependency"}, {"properties": {"id": {"const": "mesa-file-license-closure"}, "proven": {"const": false}, "evidence_sha256": {"const": ""}}}]},
        {"allOf": [{"$ref": "#/$defs/dependency"}, {"properties": {"id": {"const": "mesa-generator-output-lock"}, "proven": {"const": true}, "evidence_sha256": {"const": "8274e5dd8cc50b41e4f0e510e87e9a2d669248bd69ae988e6dbdb48ce28390e5"}}}]},
        {"allOf": [{"$ref": "#/$defs/dependency"}, {"properties": {"id": {"const": "mesa-generated-source-reproducibility"}, "proven": {"const": true}, "evidence_sha256": {"const": "d37322e969730fb71d2663c19752728802631cb9bd55b3d294824e3ac4ca2f0b"}}}]},
        {"allOf": [{"$ref": "#/$defs/dependency"}, {"properties": {"id": {"const": "direct-pruned-build-recipe"}, "proven": {"const": false}, "evidence_sha256": {"const": ""}}}]},
        {"allOf": [{"$ref": "#/$defs/dependency"}, {"properties": {"id": {"const": "gsw-886-win98-i686-v1"}, "proven": {"const": false}, "evidence_sha256": {"const": ""}}}]},
        {"allOf": [{"$ref": "#/$defs/dependency"}, {"properties": {"id": {"const": "original-gsw-winsys"}, "proven": {"const": false}, "evidence_sha256": {"const": ""}}}]},
        {"allOf": [{"$ref": "#/$defs/dependency"}, {"properties": {"id": {"const": "original-gsw-memory-helpers"}, "proven": {"const": false}, "evidence_sha256": {"const": ""}}}]},
        {"allOf": [{"$ref": "#/$defs/dependency"}, {"properties": {"id": {"const": "backend-exclusion-proof"}, "proven": {"const": false}, "evidence_sha256": {"const": ""}}}]},
        {"allOf": [{"$ref": "#/$defs/dependency"}, {"properties": {"id": {"const": "compile-output-reproducibility"}, "proven": {"const": false}, "evidence_sha256": {"const": ""}}}]}
      ],
      "items": false
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "proven", "evidence_sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "proven": {"type": "boolean"},
        "evidence_sha256": {
          "type": "string",
          "pattern": "^$|^[0-9a-f]{64}$"
        }
      }
    }
  }
}
