{
  "_spdx": "GPL-3.0-only",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vkd3d-shader-toolchain-lock.schema.json",
  "title": "RETVRN99 vkd3d-shader host toolchain lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_spdx",
    "schema",
    "schema_definition",
    "name",
    "status",
    "reason",
    "roots",
    "packages",
    "files",
    "trees",
    "tool_probes",
    "recipes",
    "environment",
    "process_limits",
    "host_dependencies",
    "authorizations"
  ],
  "properties": {
    "_spdx": {"const": "GPL-3.0-only"},
    "schema": {"const": 1},
    "schema_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": {"const": "vkd3d-shader-toolchain-lock.schema.json"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "name": {"const": "vkd3d-shader-host-tools-20260722"},
    "status": {"const": "ready"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 1024},
    "roots": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/root"}
    },
    "packages": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {"$ref": "#/$defs/package"}
    },
    "files": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {"$ref": "#/$defs/file"}
    },
    "trees": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/tree"}
    },
    "tool_probes": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/probe"}
    },
    "recipes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/recipe"}
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inherit", "clear", "set", "path_entries"],
      "properties": {
        "inherit": {
          "type": "array",
          "prefixItems": [
            {"const": "SystemRoot"},
            {"const": "WINDIR"}
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "clear": {
          "type": "array",
          "minItems": 20,
          "maxItems": 64,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "uniqueItems": true
        },
        "set": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "LC_ALL",
            "LANG",
            "TZ",
            "SOURCE_DATE_EPOCH",
            "PERL_JSON_BACKEND"
          ],
          "properties": {
            "LC_ALL": {"const": "C"},
            "LANG": {"const": "C"},
            "TZ": {"const": "UTC"},
            "SOURCE_DATE_EPOCH": {"const": "0"},
            "PERL_JSON_BACKEND": {"const": "JSON::PP"}
          }
        },
        "path_entries": {
          "type": "array",
          "prefixItems": [
            {"const": "msys:usr/bin"},
            {"const": "ucrt64:bin"},
            {"const": "git:mingw64/bin"},
            {"const": "git:usr/bin"},
            {"const": "host:System32"}
          ],
          "minItems": 5,
          "maxItems": 5
        }
      }
    },
    "process_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_shell",
        "maximum_top_level_processes",
        "maximum_process_tree_width",
        "timeout_seconds",
        "termination_grace_seconds",
        "maximum_stdout_bytes",
        "maximum_stderr_bytes",
        "terminate_process_tree",
        "temporary_output_root_required",
        "complete_cleanup_required"
      ],
      "properties": {
        "no_shell": {"const": true},
        "maximum_top_level_processes": {"const": 1},
        "maximum_process_tree_width": {"const": 5},
        "timeout_seconds": {"const": 30},
        "termination_grace_seconds": {"const": 5},
        "maximum_stdout_bytes": {"const": 1048576},
        "maximum_stderr_bytes": {"const": 1048576},
        "terminate_process_tree": {"const": true},
        "temporary_output_root_required": {"const": true},
        "complete_cleanup_required": {"const": true}
      }
    },
    "host_dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_dlls"],
      "properties": {
        "system_dlls": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.dll$"},
          "uniqueItems": true
        }
      }
    },
    "authorizations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fetch",
        "download",
        "install_tools",
        "link_production_binaries",
        "stage_payloads",
        "activate",
        "run_guest",
        "graphics_capability_advertisement"
      ],
      "properties": {
        "fetch": {"const": false},
        "download": {"const": false},
        "install_tools": {"const": false},
        "link_production_binaries": {"const": false},
        "stage_payloads": {"const": false},
        "activate": {"const": false},
        "run_guest": {"const": false},
        "graphics_capability_advertisement": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 96},
    "root_id": {"enum": ["msys", "ucrt64", "git", "package_cache"]},
    "safe_relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000-\\u001f:*?\"<>|]+$"
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "required_live"],
      "properties": {
        "id": {"$ref": "#/$defs/root_id"},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 128},
        "required_live": {"const": true}
      }
    },
    "archive_present": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "relative_path", "bytes", "sha256"],
      "properties": {
        "present": {"const": true},
        "relative_path": {"$ref": "#/$defs/safe_relative_path"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "archive_absent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "relative_path", "bytes", "sha256"],
      "properties": {
        "present": {"const": false},
        "relative_path": {"const": ""},
        "bytes": {"const": 0},
        "sha256": {"const": ""}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "name", "version", "architecture", "archive"],
      "properties": {
        "root": {"enum": ["msys", "ucrt64", "git"]},
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$", "maxLength": 96},
        "version": {"type": "string", "minLength": 1, "maxLength": 96},
        "architecture": {"enum": ["x86_64", "any"]},
        "archive": {
          "oneOf": [
            {"$ref": "#/$defs/archive_present"},
            {"$ref": "#/$defs/archive_absent"}
          ]
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "root", "relative_path", "role", "bytes", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "root": {"enum": ["msys", "ucrt64", "git"]},
        "relative_path": {"$ref": "#/$defs/safe_relative_path"},
        "role": {"enum": ["executable", "runtime-library", "module", "package-metadata"]},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tree_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_count",
        "directory_count",
        "total_entries",
        "aggregate_bytes",
        "maximum_file_bytes",
        "maximum_path_bytes",
        "digest_algorithm",
        "sha256"
      ],
      "properties": {
        "file_count": {"type": "integer", "minimum": 1, "maximum": 1024},
        "directory_count": {"type": "integer", "minimum": 0, "maximum": 128},
        "total_entries": {"type": "integer", "minimum": 1, "maximum": 1152},
        "aggregate_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "maximum_file_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "maximum_path_bytes": {"type": "integer", "minimum": 1, "maximum": 512},
        "digest_algorithm": {"const": "retvrn99-file-tree-sha256-v1"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "root", "relative_path", "role", "descriptor"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "root": {"enum": ["msys", "ucrt64"]},
        "relative_path": {"$ref": "#/$defs/safe_relative_path"},
        "role": {"enum": ["bison-data", "gcc-internal-headers"]},
        "descriptor": {"$ref": "#/$defs/tree_descriptor"}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file_id",
        "arguments",
        "expected_stream",
        "expected_lines",
        "exit_code",
        "timeout_ms",
        "maximum_output_bytes"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "file_id": {"$ref": "#/$defs/id"},
        "arguments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "expected_stream": {"enum": ["stdout", "stderr"]},
        "expected_lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "exit_code": {"const": 0},
        "timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 10000},
        "maximum_output_bytes": {"type": "integer", "minimum": 256, "maximum": 65536}
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tool_file_id", "provenance", "arguments", "standard_output"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "tool_file_id": {"$ref": "#/$defs/id"},
        "provenance": {"enum": ["upstream", "closure-proof"]},
        "arguments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 48,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "standard_output": {"enum": ["capture-as-output", "capture-for-validation"]}
      }
    }
  }
}
